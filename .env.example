# Environment Variables for GoHealthTrip Platform
# PostgreSQL Connection (compatible with Vercel Postgres, Neon, Supabase, RDS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gohealthtrip?schema=public&sslmode=prefer"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gohealthtrip?schema=public&sslmode=prefer"

# Platform Secrets
NEXTAUTH_SECRET="ght_super_secret_session_key_production_grade_32_bytes"
NEXTAUTH_URL="http://localhost:3000"

# Storage Configuration (AWS S3 / MinIO / Vercel Blob)
S3_BUCKET_NAME="gohealthtrip-medical-vault"
S3_REGION="ap-south-1" # Mumbai, India
S3_ACCESS_KEY_ID="demo_s3_key"
S3_SECRET_ACCESS_KEY="demo_s3_secret"

# Encryption Keys (AES-256 for PII / KYC hashing)
ENCRYPTION_KEY_SECRET="ght_aes256_kms_vault_secret_key_32chars"

# Active Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
